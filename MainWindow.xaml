
<Window x:Class="VoidBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Void Browser"
        Width="1280"
        Height="800"
        MinWidth="760"
        MinHeight="500"
        Background="#111820"
        Foreground="#EAF4F8"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- Browser button style -->
        <Style x:Key="BrowserButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B9C9D2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#263D49"/>
                                <Setter Property="Foreground"
                                        Value="#43D9F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#315363"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Address bar style -->
        <Style x:Key="AddressBarStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#202B35"/>
            <Setter Property="Foreground" Value="#EAF4F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#43D9F5"/>
            <Setter Property="SelectionBrush" Value="#287C91"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="AddressBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                BorderThickness="1"
                                BorderBrush="#293B47">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="AddressBorder"
                                        Property="BorderBrush"
                                        Value="#287C91"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AddressBorder"
                                        Property="BorderBrush"
                                        Value="#3B5968"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab style -->
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#9BAEB9"/>
            <Setter Property="Background" Value="#19232C"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="3,5,3,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                ContentSource="Header"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#263B47"/>
                                <Setter Property="Foreground"
                                        Value="#8DEBFA"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#263641"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="#111820">
        <Grid.RowDefinitions>
            <RowDefinition Height="43"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TAB BAR -->
        <Border Grid.Row="0"
                Background="#151F28"
                BorderBrush="#25343F"
                BorderThickness="0,0,0,1">

            <DockPanel LastChildFill="True">

                <Button Content="+"
                        DockPanel.Dock="Right"
                        Style="{StaticResource BrowserButton}"
                        Width="34"
                        Height="32"
                        Margin="5,3,9,3"
                        FontSize="22"
                        Click="NewTabButton_Click"/>

                <TabControl x:Name="Tabs"
                            Background="Transparent"
                            BorderThickness="0"
                            SelectionChanged="Tabs_SelectionChanged">

                    <!-- Header-only template.
                         Web content is displayed below the toolbar. -->
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <TabPanel IsItemsHost="True"
                                      Background="Transparent"
                                      KeyboardNavigation.TabNavigation="Local"/>
                        </ControlTemplate>
                    </TabControl.Template>

                </TabControl>
            </DockPanel>
        </Border>

        <!-- NAVIGATION BAR -->
        <Border Grid.Row="1"
                Background="#151F28"
                Padding="10,7">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="&lt;"
                        Style="{StaticResource BrowserButton}"
                        Click="BackButton_Click"/>

                <Button Grid.Column="1"
                        Content="&gt;"
                        Style="{StaticResource BrowserButton}"
                        Click="ForwardButton_Click"/>

                <Button Grid.Column="2"
                        Content="↻"
                        Style="{StaticResource BrowserButton}"
                        Click="RefreshButton_Click"/>

                <TextBox x:Name="AddressBar"
                         Grid.Column="3"
                         Height="36"
                         Margin="10,0,10,0"
                         Style="{StaticResource AddressBarStyle}"
                         KeyDown="AddressBar_KeyDown"/>

                <Button Grid.Column="4"
                        Content="⌂"
                        Style="{StaticResource BrowserButton}"
                        Click="HomeButton_Click"/>
            </Grid>
        </Border>

        <!-- SELECTED WEBPAGE -->
        <ContentPresenter Grid.Row="2"
                  Content="{Binding SelectedContent, ElementName=Tabs}"/>
    </Grid>
</Window>
